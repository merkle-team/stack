{
  "name": "stack",
  "version": "0.0.95",
  "license": "None",
  "private": true,
  "type": "module",
  "bin": {
    "stack": "build/bin/stack"
  },
  "scripts": {
    "build": "export HUSKY=0; mkdir -p build && bun install --frozen-lockfile && bun build --target=bun --minify --sourcemap=linked --outdir build ./src/cli.ts && rm -rf .*.bun-build",
    "lint": "bunx tsc --noEmit",
    "prepare": "bunx husky install",
    "fmt": "bunx prettier --write ."
  },
  "dependencies": {
    "@aws-sdk/client-auto-scaling": "3.1156.0",
    "@aws-sdk/client-dynamodb": "3.1156.0",
    "@aws-sdk/client-ec2": "3.1156.0",
    "@aws-sdk/client-secrets-manager": "3.1156.0",
    "@aws-sdk/credential-provider-node": "3.972.88",
    "@aws-sdk/types": "3.975.0",
    "@aws-sdk/util-retry": "3.374.0",
    "@cdktf/provider-aws": "21.22.1",
    "@commander-js/extra-typings": "12.1.0",
    "@sinclair/typebox": "0.32.37",
    "cdktf-cli": "0.21.0",
    "commander": "12.1.0",
    "constructs": "10.8.1",
    "execa": "9.6.1",
    "uint8array-extras": "1.6.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "cdktf": "0.21.0",
    "husky": "9.1.7",
    "typescript": "5.9.3"
  }
}
